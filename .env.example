# Copy to .env (never commit .env). All values are optional in development.

# development | test | production
APP_ENV=development
PORT=4180
# Public https:// origin; required in production (cookies become Secure).
APP_ORIGIN=
# Folder for the SQLite database and uploaded files.
DATA_DIR=.relo-data
# 1 = create the public demo account (development only).
SEED_DEMO=

# Google Gemini. Without a key the AI buttons are hidden and the rule-based draft is used.
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite. Higher quality: gemini-3.8-flash.
GEMINI_MODEL=
# AI calls per user per hour.
AI_HOURLY_LIMIT=30
