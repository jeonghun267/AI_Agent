# Copy to .env (never commit .env). All values are optional in development.

# development | test | production
APP_ENV=development
PORT=4180
# Public https:// origin; required in production (cookies become Secure).
APP_ORIGIN=
# Folder for the SQLite database and uploaded files.
DATA_DIR=.relo-data
# 1 = create the public demo account (development only).
SEED_DEMO=

# Google Gemini. Without a key the AI buttons are hidden and the rule-based draft is used.
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite. Higher quality: gemini-3.8-flash.
GEMINI_MODEL=
# AI calls per user per hour.
AI_HOURLY_LIMIT=30

# Account mail (email verification, password reset).
# resend   = send through Resend (default when RESEND_API_KEY is set)
# console  = print messages and their links to the server log (development default without a key; refused in production)
# disabled = no account mail; the reset link and verification band are hidden (production default without a key)
MAIL_PROVIDER=
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. ReLo <no-reply@your-domain>. Required in production.
# Outside production the default is Resend's test sender, which only delivers to your own Resend account address.
MAIL_FROM=
