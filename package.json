{
  "name": "relo",
  "version": "2.0.0",
  "description": "ReLo: 해외 직구 반품·교환·AS 클레임을 청구부터 실제 회수까지 기록하는 B2C 웹 서비스",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/main.mjs",
    "dev": "node --env-file-if-exists=.env --watch-path=src src/server/main.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/http/**/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/**/*.test.mjs\"",
    "ai:smoke": "node --env-file-if-exists=.env scripts/ai-smoke.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
